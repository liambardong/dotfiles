# Theme switching based on system appearance
theme = light:Atom One Light,dark:Atom One Dark

# Window transparency (nvim themes are set transparent to show this through)
background-opacity = 0.8

# Cursor color follows theme (fixes color not updating on mode switch)
cursor-color = cell-foreground
cursor-text = cell-background

custom-shader = shaders/cursor-shaders/cursor_tail.glsl

# Keeps animation running even when the window loses focus
custom-shader-animation = always
